# Local development. Copy to .env and adjust.
DATABASE_URL=postgres://otrolado:otrolado@localhost:5432/otrolado
# Numbered DB (…/1) keeps our keys in their own space, so another project
# using Redis on this machine cannot collide with or flush ours.
REDIS_URL=redis://localhost:6379/1
PORT=3000
LOG_LEVEL=info

# Ingest
CBP_FEED_URL=https://bwt.cbp.gov/api/bwtnew
INGEST_INTERVAL_MS=900000

# Comma-separated CBP port_numbers to archive. Empty = every crossing the feed
# reports, which is the default: it is the same single feed call either way,
# and wait history cannot be backfilled. The UI scopes to the pilot region
# separately — this setting is about collection, not display.
INGEST_PORT_IDS=

# Feed-age thresholds (seconds) — drive the ESTIMATED badge and staleness UI.
ESTIMATED_AFTER_S=1800
STALE_AFTER_S=2700
