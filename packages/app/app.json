{
  "expo": {
    "name": "Otrolado",
    "slug": "otrolado",
    "scheme": "otrolado",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Otrolado uses your location to estimate the drive to each border crossing, so it can rank them by total time.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 248,
          "resizeMode": "contain",
          "backgroundColor": "#1B45C4"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.otrolado.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["comgooglemaps", "waze"]
      }
    },
    "android": {
      "package": "com.otrolado.app",
      "adaptiveIcon": {
        "backgroundColor": "#1B45C4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
